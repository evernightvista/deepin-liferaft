#: main.cpp:413
msgid "System memory information unavailable"
msgstr "Systemspeicherinformationen nicht verfügbar"

#: main.cpp:414
msgid "Available memory %1 · Total memory %2"
msgstr "Verfügbarer Speicher %1 · Gesamter Speicher %2"

#: main.cpp:425
msgid "Swap not configured"
msgstr "Swap nicht konfiguriert"

#: main.cpp:426
msgid "Available swap %1 · Total swap %2"
msgstr "Verfügbarer Swap %1 · Gesamter Swap %2"

#: main.cpp:799
msgid "Paused"
msgstr "Pausiert"

#: main.cpp:925
msgid "Low memory"
msgstr "Wenig Speicher"

#: main.cpp:926
msgid ""
"The following apps have been paused to keep your system responsive. Resume "
"them, or force quit to free up memory."
msgstr ""
"Die folgenden Apps wurden pausiert, um Ihr System reaktionsschnell zu halten. "
"Setzen Sie sie fort oder beenden Sie sie erzwungen, um Speicher freizugeben."

#: main.cpp:948
msgid "Application"
msgstr "Anwendung"

#: main.cpp:949
msgid "Memory"
msgstr "Speicherverbrauch"

#: main.cpp:968
msgid "No applications to show"
msgstr "Keine anzuzeigenden Anwendungen"

#: main.cpp:988
msgid "Resume"
msgstr "Fortsetzen"

#: main.cpp:989
msgid "Resume app"
msgstr "App fortsetzen"

#: main.cpp:991
msgid "Force Quit"
msgstr "Beenden erzwingen"

#: main.cpp:992
msgid "Force quit app"
msgstr "App zum Beenden zwingen"

#: main.cpp:1012
msgid "Resumed %1"
msgstr "%1 fortgesetzt"

#: main.cpp:1014
msgid "Resume failed for %1"
msgstr "Fortsetzen von %1 fehlgeschlagen"

#: main.cpp:1028
msgid "Force quit %1: kill=%2 thaw=%3"
msgstr "%1 erzwungen beendet: kill=%2 thaw=%3"

#: main.cpp:1030
msgid "Force quit %1 failed: kill=%2 thaw=%3"
msgstr "%1 erzwungenes Beenden fehlgeschlagen: kill=%2 thaw=%3"

#: main.cpp:1101
msgid "Memory pressure above limit: %1%"
msgstr "Speicherdruck über dem Grenzwert: %1%"

#: main.cpp:1105
msgid "Memory pressure back below limit: %1%"
msgstr "Speicherdruck wieder unter dem Grenzwert: %1%"

#: main.cpp:1128
msgid "Invalid samples: pressure=%1 memory=%2 userPgscan=%3 appSample=%4"
msgstr "Ungültige Stichproben: pressure=%1 memory=%2 userPgscan=%3 appSample=%4"

#: main.cpp:1143
msgid ""
"Trigger %1: pressure=%2%% duration=%3ms recentReclaim=%4 memUsed=%5%% "
"swapUsed=%6%% apps=%7"
msgstr ""
"Auslöser %1: pressure=%2%% duration=%3ms recentReclaim=%4 memUsed=%5%% "
"swapUsed=%6%% apps=%7"

#: main.cpp:1191
msgid "Frozen %1 (%2) trigger=%3 reclaim=%4MB swap=%5MB memory=%6MB"
msgstr "%1 (%2) eingefroren trigger=%3 reclaim=%4MB swap=%5MB memory=%6MB"

#: main.cpp:1201
msgid "Cannot freeze %1 (%2): unreadable or frozen by another component"
msgstr ""
"%1 (%2) kann nicht eingefroren werden: nicht lesbar oder durch andere "
"Komponente eingefroren"

#: main.cpp:1226
msgid "Shutdown requested, thawing %1 frozen cgroup(s)"
msgstr "Herunterfahren angefordert, %1 eingefrorene(s) cgroup(s) werden aufgetaut"

#: main.cpp:1233
msgid "All frozen cgroups thawed, exiting"
msgstr "Alle eingefrorenen cgroups aufgetaut, Vorgang wird beendet"

#: main.cpp:1237
msgid "Thaw incomplete (%1 cgroup(s) remain), retrying"
msgstr "Auftauen unvollständig (%1 cgroup(s) verbleiben), neuer Versuch"

#: main.cpp:1335
msgid "Window closing, thawing %1 frozen cgroup(s)"
msgstr "Fenster wird geschlossen, %1 eingefrorene(s) cgroup(s) werden aufgetaut"

#: main.cpp:1337
msgid "Close blocked: thaw failed, retrying"
msgstr "Schließen blockiert: Auftauen fehlgeschlagen, neuer Versuch"

#: main.cpp:1365
msgid "%1 application is still paused"
msgid_plural "%1 applications are still paused"
msgstr[0] "%1 Anwendung noch pausiert"
msgstr[1] "%1 Anwendungen noch pausiert"

#: main.cpp:1375
msgid ""
"Closing the window resumes them immediately, and the system may become "
"unresponsive again."
msgstr ""
"Das Schließen des Fensters setzt sie sofort fort, und das System könnte "
"wieder nicht reagieren."

#: main.cpp:1382
msgid "Cancel"
msgstr "Abbrechen"

#: main.cpp:1383
msgid "Close and Resume"
msgstr "Schließen und Fortsetzen"

#: main.cpp:1400
msgid "Close cancelled, %1 frozen cgroup(s) stay paused"
msgstr "Schließen abgebrochen, %1 eingefrorene(s) cgroup(s) bleiben pausiert"

#: main.cpp:1404
msgid "Close confirmed, resuming %1 frozen cgroup(s)"
msgstr "Schließen bestätigt, %1 eingefrorene(s) cgroup(s) werden fortgesetzt"

#: main.cpp:1447
msgid "Memory Liferaft"
msgstr "Speicher-Rettungsboot"

#: main.cpp:1451
msgid "Application whitelist: %1 entries"
msgstr "Anwendungs-Whitelist: %1 Einträge"

#: main.cpp:1454
msgid "Memory Liferaft started: pid=%1 mode=%2"
msgstr "Speicher-Rettungsboot gestartet: pid=%1 mode=%2"
